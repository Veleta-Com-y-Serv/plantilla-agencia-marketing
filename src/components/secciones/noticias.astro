---
// Blog de la agencia en banda crema: cabecera con título a la izquierda y enlace «ver todos» (`cta`)
// a la derecha; artículos en 1, 2 y 3 columnas con foto, categoría en etiqueta lima, fecha, título y
// entradilla. `noticias`: titulo, texto, fecha, categoria, imagen, url (sin url no enlaza).
import { seccion, externo } from '../../data/site';
import { altFicha } from '../../lib/seo';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const articulos = s ? s.noticias.slice(0, 9) : [];
const fuera = (u?: string) => (externo(u) ? { rel: 'noopener', target: '_blank' } : {});
---

{
  s && (articulos.length > 0 || s.titulo) && (
    <Seccion id={Astro.props.id} banda="crema">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <Titular class="!mb-0" antetitulo={s.antetitulo} titulo={s.titulo} resalte={s.resalte} texto={s.texto} />
        {s.cta && (
          <a href={s.cta.url} class="enlace-flecha shrink-0 border-b-2 border-acento text-primario" {...fuera(s.cta.url)}>
            {s.cta.texto} <Icono nombre="flecha" tam={16} />
          </a>
        )}
      </div>
      {articulos.length > 0 && (
        <ul class="mt-12 grid gap-x-8 gap-y-14 md:mt-16 md:grid-cols-2 lg:grid-cols-3">
          {articulos.map((n) => (
            <li>
              <article class="articulo group flex h-full flex-col">
                <div class="relative overflow-hidden rounded-xl bg-primario">
                  <Imagen src={n.imagen || '/placeholders/noticia-1.svg'} alt={altFicha(n)} ancho={900} alto={600} class="aspect-[3/2] w-full object-cover transition duration-500 group-hover:scale-105" />
                  {n.categoria && <span class="absolute left-4 top-4 rounded-full bg-acento px-3 py-1.5 text-[.7rem] font-extrabold uppercase tracking-[.14em] text-primario">{n.categoria}</span>}
                </div>
                {n.fecha && <p class="mt-6 text-xs font-bold uppercase tracking-[.16em] opacity-60">{n.fecha}</p>}
                <h3 class="mt-2 text-2xl leading-tight text-primario md:text-[1.7rem]">
                  {n.url ? <a href={n.url} class="titulo-enlace" {...fuera(n.url)}>{n.titulo}</a> : n.titulo}
                </h3>
                {n.texto && <p class="mt-3 opacity-80">{n.texto}</p>}
              </article>
            </li>
          ))}
        </ul>
      )}
    </Seccion>
  )
}

<style>
  .titulo-enlace { text-decoration: none; background: linear-gradient(var(--c-acento), var(--c-acento)) 0 100% / 0 .18em no-repeat; transition: background-size .25s ease; }
  .articulo:hover .titulo-enlace, .titulo-enlace:focus-visible { background-size: 100% .18em; }
</style>
