---
// Cómo trabajamos, en banda morada: pasos en fila (1, 2 y 4 columnas) unidos por una línea lima, con
// número enorme en contorno, icono, plazo (`duracion`), título y texto. `items`: titulo, texto, icono,
// duracion. Sin pasos solo queda el titular; sin nada, no se pinta.
import { seccion } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const pasos = s ? s.items.slice(0, 8) : [];
const COLUMNAS: Record<number, string> = { 1: '', 2: 'md:grid-cols-2', 3: 'md:grid-cols-3', 4: 'md:grid-cols-2 lg:grid-cols-4' };
---

{
  s && (pasos.length > 0 || s.titulo) && (
    <Seccion id={Astro.props.id} banda="oscura">
      <div slot="fondo" class="anillo -right-48 top-10 h-[36rem] w-[36rem]" aria-hidden="true" />
      <div class="grid gap-6 lg:grid-cols-[1.4fr_1fr] lg:items-end lg:gap-16">
        <Titular class="!mb-0" antetitulo={s.antetitulo} titulo={s.titulo} resalte={s.resalte} />
        {s.texto && <p class="text-lg opacity-80 lg:pb-3">{s.texto}</p>}
      </div>
      {pasos.length > 0 && (
        <ol class:list={['pasos mt-14 grid gap-10 md:mt-20 md:gap-8', COLUMNAS[Math.min(pasos.length, 4)] ?? COLUMNAS[4]]}>
          {pasos.map((p, i) => (
            <li class="paso relative pt-10">
              <span class="numero font-display text-[5.5rem] font-black leading-none tracking-tighter" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div class="mt-4 flex flex-wrap items-center gap-3">
                <span class="grid h-10 w-10 place-items-center rounded-full bg-acento text-primario" aria-hidden="true">
                  <Icono nombre={p.icono} tam={20} />
                </span>
                {p.duracion && <span class="rounded-full border border-white/25 px-3 py-1 text-xs font-bold uppercase tracking-[.14em]">{p.duracion}</span>}
              </div>
              <h3 class="mt-5 text-2xl md:text-[1.7rem]">{p.titulo}</h3>
              {p.texto && <p class="mt-3 opacity-75">{p.texto}</p>}
            </li>
          ))}
        </ol>
      )}
    </Seccion>
  )
}

<style>
  .paso::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--c-acento); border-radius: 3px; }
  .paso::after { content: ""; position: absolute; top: -6px; left: 0; width: 15px; height: 15px; border-radius: 9999px; background: var(--c-acento); }
  .numero { display: block; color: transparent; -webkit-text-stroke: 2px color-mix(in srgb, var(--c-acento) 80%, transparent); }
</style>
