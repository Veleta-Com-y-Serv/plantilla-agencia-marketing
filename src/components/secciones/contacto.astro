---
// Contacto partido a sangre: la mitad izquierda en morado hasta el borde de la ventana (titular,
// teléfono enorme en lima y el resto de datos de site.yaml → contacto); la derecha en crema con el
// formulario (mailto). `boton`: texto del botón del formulario (si no, uno genérico).
import { seccion, site, tel, mapa, whatsapp } from '../../data/site';
import Titular from '../ui/Titular.astro';
import Icono from '../ui/Icono.astro';
import FormularioContacto from '../ui/FormularioContacto.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const c = site.contacto;
const datos = [
  c.email && { icono: 'correo', etiqueta: 'Email', valor: c.email, url: `mailto:${c.email}`, fuera: false },
  c.whatsapp && { icono: 'whatsapp', etiqueta: 'WhatsApp', valor: c.whatsapp, url: whatsapp(c.whatsapp), fuera: true },
  c.direccion && { icono: 'mapa', etiqueta: 'Estudio', valor: c.direccion, url: mapa(c.direccion), fuera: true },
  c.horario && { icono: 'reloj', etiqueta: 'Horario', valor: c.horario, url: '', fuera: false },
].filter(Boolean) as { icono: string; etiqueta: string; valor: string; url: string; fuera: boolean }[];
const boton = String(s?.boton ?? '').trim() || 'Enviar mensaje';
---

{
  s && (
    <section id={Astro.props.id} class="banda bg-fondo text-texto">
      <div class="grid lg:grid-cols-2">
        <div class="banda banda--oscura contacto-izq px-4 py-16 md:px-12 md:py-24 lg:py-28">
          <div class="anillo -bottom-40 -left-40 h-[26rem] w-[26rem]" aria-hidden="true" />
          <div class="max-w-[38rem] lg:ml-auto">
            <Titular class="!mb-0" antetitulo={s.antetitulo} titulo={s.titulo} resalte={s.resalte} texto={s.texto} />
            {c.telefono && (
              <a href={tel(c.telefono)} class="mt-10 inline-block font-display text-[clamp(2.1rem,5vw,3.6rem)] font-black leading-none tracking-tight text-acento hover:underline">
                {c.telefono}
              </a>
            )}
            {datos.length > 0 && (
              <dl class="mt-10 grid gap-6 sm:grid-cols-2">
                {datos.map((d) => (
                  <div class="flex gap-3">
                    <Icono nombre={d.icono} class="mt-0.5 shrink-0 text-acento" tam={20} />
                    <div class="min-w-0">
                      <dt class="text-xs font-bold uppercase tracking-[.16em] opacity-60">{d.etiqueta}</dt>
                      <dd class="mt-1 break-words">
                        {d.url ? <a href={d.url} class="hover:text-acento" {...(d.fuera && { rel: 'noopener', target: '_blank' })}>{d.valor}</a> : d.valor}
                      </dd>
                    </div>
                  </div>
                ))}
              </dl>
            )}
          </div>
        </div>
        <div class="px-4 py-16 md:px-12 md:py-24 lg:py-28">
          <div class="max-w-[38rem]">
            <FormularioContacto boton={boton} />
          </div>
        </div>
      </div>
    </section>
  )
}
