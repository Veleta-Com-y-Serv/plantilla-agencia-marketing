---
// Servicios en una rejilla a todo el ancho del contenido (1, 2 y 3 columnas; 4 si son 4 u 8): celdas
// separadas por filetes, número, icono, título grande, texto y enlace. La que lleva `destacado: true`
// sale en morado. Cabecera partida: título a la izquierda, texto y botón a la derecha.
// `items`: titulo, texto, icono, url, destacado.
import { seccion, externo } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const items = s ? s.items : [];
const cuatro = items.length === 4 || items.length === 8;
---

{
  s && (
    <Seccion id={Astro.props.id} banda="clara">
      <div class="grid gap-6 lg:grid-cols-[1.3fr_1fr] lg:items-end lg:gap-16">
        <Titular class="!mb-0" antetitulo={s.antetitulo} titulo={s.titulo} resalte={s.resalte} />
        {(s.texto || s.cta) && (
          <div class="lg:pb-3">
            {s.texto && <p class="text-lg opacity-80">{s.texto}</p>}
            {s.cta && <a class="btn mt-6" href={s.cta.url}>{s.cta.texto}</a>}
          </div>
        )}
      </div>
      {items.length > 0 && (
        <ul class:list={['servicios mt-12 grid border-t-2 border-primario sm:grid-cols-2 md:mt-16', cuatro ? 'xl:grid-cols-4' : 'lg:grid-cols-3']}>
          {items.map((it, i) => (
            <li class:list={['servicio group relative flex flex-col p-6 md:p-8', it.destacado && 'servicio--destacado']}>
              <div class="flex items-center justify-between">
                <span class="font-display text-sm font-black tracking-[.2em] opacity-60">{String(i + 1).padStart(2, '0')}</span>
                <span class="icono grid h-14 w-14 place-items-center rounded-2xl" aria-hidden="true">
                  <Icono nombre={it.icono} tam={26} />
                </span>
              </div>
              <h3 class="mt-8 text-[1.65rem] md:text-3xl">{it.titulo}</h3>
              {it.texto && <p class="mt-3 opacity-80">{it.texto}</p>}
              {it.url && (
                <a href={it.url} class="enlace-flecha mt-auto pt-6" {...(externo(it.url) && { rel: 'noopener', target: '_blank' })}>
                  Saber más <Icono nombre="flecha" tam={16} />
                </a>
              )}
            </li>
          ))}
        </ul>
      )}
    </Seccion>
  )
}

<style>
  .servicio { border-bottom: 1px solid var(--c-linea); transition: background-color .2s ease, color .2s ease; }
  .servicio h3 { color: var(--c-primario); }
  .servicio .enlace-flecha { color: var(--c-primario); }
  .servicio .icono { background: color-mix(in srgb, var(--c-primario) 8%, transparent); color: var(--c-primario); transition: inherit; }
  @media (min-width: 640px) { .servicio { border-right: 1px solid var(--c-linea); } }
  .servicio--destacado, .servicio:hover { background: var(--c-primario); color: var(--c-sobre-oscuro); }
  .servicio--destacado h3, .servicio:hover h3 { color: var(--c-sobre-oscuro); }
  .servicio--destacado .icono, .servicio:hover .icono { background: var(--c-acento); color: var(--c-primario); }
  .servicio--destacado .enlace-flecha, .servicio:hover .enlace-flecha { color: var(--c-acento); }
</style>
