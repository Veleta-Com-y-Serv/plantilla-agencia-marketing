---
// Ficha de un elemento con `detalle` (src/lib/paginas.ts, listas de src/data/fichas.ts): /servicios/<slug>/.
// Diseño «directo»: banda morada con anillo, migas y título grande, botón magenta y foto con filete lima
// (o icono grande en caja lima); banda crema con el `detalle` y, al lado, la tabla de datos y la caja lima;
// fotos en banda clara y otros servicios en rejilla con filetes como la portada.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import Titular from '../../components/ui/Titular.astro';
import { seccion, site, tel, whatsapp } from '../../data/site';
import { fichas, relacionadas, resumen } from '../../lib/paginas';
import type { Ficha } from '../../lib/paginas';
import { altGaleria, jsonLdFicha, jsonLdMigas, urlBase } from '../../lib/seo';
import { enlace, rutaDeSeccion } from '../../lib/multipagina';

export function getStaticPaths() {
  return fichas().map((f) => ({ params: { coleccion: f.def.ruta, slug: f.slug }, props: { f } }));
}

interface Props { f: Ficha }
const { f } = Astro.props;
const base = urlBase(Astro.site);
const nombreSeccion = String(f.seccion.antetitulo || f.seccion.titulo || f.def.nombre).trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: rutaDeSeccion(f.idSeccion) },
  { nombre: f.titulo, ruta: f.url },
];
const c = site.contacto;
const contacto = seccion('cita') ? enlace('/#cita') : site.boton_cabecera?.url || enlace('/#contacto');
const textoContacto = site.boton_cabecera?.texto || 'Pide tu diagnóstico';
const wa = whatsapp(c.whatsapp, `Hola, quiero información sobre ${f.titulo}`);
const datos = f.datos.filter((d) => d.clave !== 'precio');
const otras = relacionadas(f, 3);
const descripcion = resumen(f.texto || f.detalle[0] || '');
---

<Base titulo={f.titulo} descripcion={descripcion} imagen={f.imagen} ld={[jsonLdMigas(base, migas), jsonLdFicha(base, f)]}>
  <section class="seccion banda banda--oscura ficha-cabeza">
    <span class="anillo" style="width:34rem;height:34rem;right:-12rem;top:-14rem" aria-hidden="true"></span>
    <div class="contenedor relative">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class:list={['ficha-hero', { 'ficha-hero--sin-foto': !f.imagen }]}>
        <div class="ficha-hero-texto">
          <p class="antetitulo">{f.categoria || f.def.nombre}</p>
          <h1 class="titulo-seccion">{f.titulo}</h1>
          {f.texto && <p class="titular-texto">{f.texto}</p>}
          {f.precio && <p class="ficha-precio">{f.precio}</p>}
          <div class="ficha-botones">
            <a class="btn" href={contacto}>{textoContacto}</a>
            {wa && <a class="btn-sec" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> WhatsApp</a>}
          </div>
        </div>
        {f.imagen ? (
          <div class="ficha-foto">
            <Imagen src={f.imagen} alt={f.titulo} ancho={1200} alto={900} prioridad class="h-full w-full object-cover" />
          </div>
        ) : (
          <div class="ficha-icono" aria-hidden="true"><Icono nombre={f.icono || 'brujula'} tam={96} /></div>
        )}
      </div>
    </div>
  </section>

  <section class="seccion banda banda--crema">
    <div class="contenedor ficha-cuerpo">
      <article class="texto-largo ficha-detalle">
        {f.detalle.map((p) => <p>{p}</p>)}
      </article>
      <aside class="ficha-lado">
        {(datos.length > 0 || f.precio) && (
          <div class="ficha-datos">
            <h2 class="ficha-lado-titulo">En pocas palabras</h2>
            <dl>
              {f.precio && <div><dt>Precio</dt><dd>{f.precio}</dd></div>}
              {datos.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
            </dl>
          </div>
        )}
        <div class="ficha-caja">
          <p class="ficha-caja-titulo">¿Lo vemos con tu negocio?</p>
          <p>Cuéntanos tu caso y te decimos por dónde empezar, sin compromiso.</p>
          <a class="btn" href={contacto}>{textoContacto}</a>
          {c.telefono && <a class="ficha-tel" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
        </div>
      </aside>
    </div>
  </section>

  {f.imagenes.length > 0 && (
    <section class="seccion banda banda--clara" aria-label={`Fotos de ${f.titulo}`}>
      <div class="contenedor">
        <ul class="ficha-galeria">
          {f.imagenes.map((src, i) => (
            <li><Imagen src={src} alt={`${f.titulo}: ${altGaleria(i).toLowerCase()}`} ancho={800} alto={600} class="h-full w-full object-cover" /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {otras.length > 0 && (
    <section class="seccion banda banda--clara">
      <div class="contenedor">
        <Titular antetitulo={nombreSeccion} titulo="Otros servicios" />
        <ul class="ficha-otras">
          {otras.map((o) => (
            <li class="ficha-otra">
              <span class="icono grid h-14 w-14 place-items-center rounded-2xl" aria-hidden="true"><Icono nombre={o.icono || 'brujula'} tam={26} /></span>
              <h3><a href={o.url} class="ficha-otra-enlace">{o.titulo}</a></h3>
              {o.texto && <p>{o.texto}</p>}
              <span class="enlace-flecha ficha-otra-ver" aria-hidden="true">Saber más <Icono nombre="flecha" tam={16} /></span>
            </li>
          ))}
        </ul>
        <p class="mt-10"><a class="btn-sec ficha-todos" href={rutaDeSeccion(f.idSeccion)}>Ver todos los servicios</a></p>
      </div>
    </section>
  )}
</Base>

<style>
  .ficha-cabeza { position: relative; overflow: hidden; padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(3rem, 6vw, 5rem); }
  .migas ol { display: flex; flex-wrap: wrap; gap: .25rem .5rem; font-size: .8rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .migas li { display: inline-flex; align-items: center; gap: .5rem; min-width: 0; }
  .migas li + li::before { content: "/"; color: var(--c-acento); }
  .migas a { color: var(--c-sobre-oscuro); text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; opacity: .85; }
  .migas a:hover { color: var(--c-acento); opacity: 1; }
  .migas [aria-current] { color: var(--c-acento); overflow-wrap: anywhere; }
  .ficha-hero { display: grid; gap: 2.5rem; margin-top: clamp(1rem, 3vw, 2.5rem); align-items: center; }
  .ficha-hero-texto .titulo-seccion { font-size: clamp(2.3rem, 7vw, 5rem); overflow-wrap: anywhere; }
  .ficha-hero-texto .titular-texto { color: var(--c-sobre-oscuro); opacity: .85; }
  .ficha-precio { margin-top: 1.5rem; font-family: var(--fuente-titulos); font-weight: 900; font-size: 1.4rem; color: var(--c-acento); }
  .ficha-botones { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .ficha-botones a { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; }
  .ficha-foto { aspect-ratio: 4 / 3; border-radius: var(--radio); overflow: hidden; border: 3px solid var(--c-acento); }
  .ficha-icono { display: grid; place-items: center; aspect-ratio: 4 / 3; border-radius: var(--radio); background: var(--c-acento); color: var(--c-primario); }
  .ficha-cuerpo { display: grid; gap: 3rem; }
  .ficha-detalle { max-width: 44rem; font-size: 1.12rem; }
  .ficha-detalle p + p { margin-top: 1.2rem; }
  .ficha-detalle p:first-child { font-size: 1.25rem; font-weight: 600; }
  .ficha-lado { display: grid; gap: 1.5rem; align-content: start; }
  .ficha-lado-titulo { font-size: 1.25rem; margin-bottom: 1rem; color: var(--c-primario); }
  .ficha-datos { border: 2px solid var(--c-primario); border-radius: var(--radio); padding: 1.5rem; background: var(--c-fondo); }
  .ficha-datos dl > div { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 0; border-top: 1px solid var(--c-linea); }
  .ficha-datos dt { font-weight: 800; font-size: .8rem; letter-spacing: .1em; text-transform: uppercase; opacity: .7; }
  .ficha-datos dd { text-align: right; font-weight: 650; min-width: 0; overflow-wrap: anywhere; }
  .ficha-caja { display: grid; gap: .9rem; border-radius: var(--radio); padding: 1.75rem 1.5rem; background: var(--c-acento); color: var(--c-primario); }
  .ficha-caja-titulo { font-family: var(--fuente-titulos); font-size: 1.6rem; font-weight: 900; line-height: 1.15; }
  .ficha-caja .btn { display: inline-flex; align-items: center; justify-content: center; }
  .ficha-tel { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; font-weight: 800; color: var(--c-primario); text-decoration: none; }
  .ficha-galeria { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .ficha-galeria li { aspect-ratio: 4 / 3; border-radius: var(--radio); overflow: hidden; }
  .ficha-otras { display: grid; border-top: 2px solid var(--c-primario); }
  .ficha-otra { position: relative; display: flex; flex-direction: column; gap: .7rem; padding: 1.5rem; border-bottom: 1px solid var(--c-linea); transition: background-color .2s ease, color .2s ease; }
  .ficha-otra .icono { background: color-mix(in srgb, var(--c-primario) 8%, transparent); color: var(--c-primario); }
  .ficha-otra h3 { font-size: 1.6rem; margin-top: .5rem; color: var(--c-primario); }
  .ficha-otra-enlace { text-decoration: none; color: inherit; overflow-wrap: anywhere; }
  .ficha-otra-enlace::after { content: ""; position: absolute; inset: 0; }
  .ficha-otra-enlace:focus-visible { outline: none; }
  .ficha-otra:has(.ficha-otra-enlace:focus-visible) { outline: 3px solid var(--c-chispa); outline-offset: -3px; }
  .ficha-otra p { opacity: .8; }
  .ficha-otra-ver { margin-top: auto; padding-top: 1rem; color: var(--c-primario); }
  .ficha-otra:hover { background: var(--c-primario); color: var(--c-sobre-oscuro); }
  .ficha-otra:hover h3, .ficha-otra:hover .ficha-otra-ver { color: var(--c-acento); }
  .ficha-otra:hover .icono { background: var(--c-acento); color: var(--c-primario); }
  .ficha-todos { color: var(--c-primario); display: inline-flex; align-items: center; justify-content: center; }
  @media (min-width: 640px) { .ficha-otras { grid-template-columns: repeat(3, 1fr); } .ficha-otra { border-right: 1px solid var(--c-linea); } }
  @media (min-width: 1024px) {
    .ficha-hero { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 4rem; }
    .ficha-cuerpo { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 5rem; align-items: start; }
    .ficha-lado { position: sticky; top: 6.5rem; }
  }
</style>
