---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada">
  <section class="banda banda--oscura">
    <div class="anillo -right-40 -top-40 h-[34rem] w-[34rem]" aria-hidden="true"></div>
    <div class="contenedor grid min-h-[70svh] content-center py-20">
      <p class="antetitulo">Error 404</p>
      <h1 class="mt-6 text-[clamp(3rem,10vw,8rem)] font-black leading-[.9]">Esta página <em class="resalte">no existe</em></h1>
      <p class="mt-6 max-w-xl text-lg opacity-85">Puede que el enlace esté mal o que la página se haya movido.</p>
      <p class="mt-10"><a class="btn" href="/">Volver al inicio</a></p>
    </div>
  </section>
</Base>
